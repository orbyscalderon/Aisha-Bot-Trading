# Plantilla de secretos. Copia a `.env` (ignorado por git) y rellena los valores.
# NUNCA escribas valores reales en este fichero ni lo subas con ellos.

# --- Exchange (CEX) ---
# IMPORTANTE: crea las claves API SIN permiso de retirada (withdraw / retirada).
# Solo lectura y trading. Si la clave se filtra, nadie podra sacar fondos.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Solana ---
# Clave privada de una wallet dedicada con fondos limitados, nunca tu wallet principal.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=
# Clave de Helius para LEER los swaps de las wallets seguidas (comando fetch-solana-signals).
# Solo lectura; viaja en la URL, asi que el bot la limpia de los logs. Nunca en el YAML.
HELIUS_API_KEY=

# --- Alpaca (acciones) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Telegram (alertas) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Twilio (alertas SMS / llamada) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- LLM ---
LLM_API_KEY=
