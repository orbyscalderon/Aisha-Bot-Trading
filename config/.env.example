# Plantilla de secretos. Copia a `.env` (ignorado por git) y rellena los valores.
# NUNCA escribas valores reales en este fichero ni lo subas con ellos.

# --- Exchange (CEX) ---
# Solo hacen falta en modo live; en paper el bot no las mira.
#
# IMPORTANTE: crea las claves API SIN permiso de retirada (withdraw / retirada).
# Solo lectura y trading. Si la clave se filtra, nadie podra sacar fondos.
#
# Para PROBAR sin arriesgar nada, saca unas de testnet en testnet.binance.vision
# (permisos TRADE y USER_DATA) y deja `testnet: true` en el YAML. Son claves
# distintas de las de Binance real y no valen una para lo otro.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Solana ---
# Clave privada de una wallet dedicada con fondos limitados, nunca tu wallet principal.
SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=
# Clave de Helius para LEER los swaps de las wallets seguidas (comando fetch-solana-signals).
# Solo lectura; viaja en la URL, asi que el bot la limpia de los logs. Nunca en el YAML.
HELIUS_API_KEY=

# --- Alpaca (acciones) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Telegram (alertas y CONTROL del bot) ---
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# Chat al que se envian las alertas.
TELEGRAM_CHAT_ID=
# Quien puede DAR ORDENES al bot: chat_id separados por comas. Si se deja vacio se usa
# TELEGRAM_CHAT_ID. Una lista vacia no autoriza a NADIE (falla cerrado, a proposito).
# Para saber tu chat_id: escribe al bot y mira el log, o habla con @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Twilio (alertas SMS / llamada) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- LLM ---
LLM_API_KEY=
